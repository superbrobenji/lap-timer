/* build_config.h -- generated from main/build_config.h.in by the top-level
 * CMakeLists.txt (spec §4.6). Do not edit; edit the build flags instead.
 * This is the authoritative compile-time configuration for the firmware. */
#ifndef BUILD_CONFIG_H
#define BUILD_CONFIG_H

#define CFG_VARIANT_MOTO   @CFG_VARIANT_MOTO@
#define CFG_VARIANT_CAR    @CFG_VARIANT_CAR@

#define CFG_GPS_NAME       "@GPS@"
#define CFG_DISPLAY_NAME   "@DISPLAY@"

/* 1 on the bench build whose GPS driver is gps_sim (replays the committed synthetic capture); the
 * pipeline reads the sim venue from gps_sim only when this is set (§4.6, 3.4). */
#define CFG_GPS_SIM        @CFG_GPS_SIM@

#define CFG_PANEL_WS213V4  @CFG_PANEL_WS213V4@
#define CFG_PANEL_WS29V2   @CFG_PANEL_WS29V2@

#define CFG_HWID           "@CFG_HWID@"
#define CFG_FW_VERSION     "@CFG_FW_VERSION@"

#define CFG_HAS_PPS        @CFG_HAS_PPS@
#define CFG_HAS_SD         @CFG_HAS_SD@
#define CFG_HAS_WIFI       @CFG_HAS_WIFI@
#define CFG_HAS_BLE        @CFG_HAS_BLE@
#define CFG_HAS_BLE_RC     @CFG_HAS_BLE_RC@
#define CFG_HAS_EXPORT_SERIAL @CFG_HAS_EXPORT_SERIAL@
/* DEVUX (§4.6, Plan 5 sub-project A): the interactive operator UX (the `dbg` diagnostics
 * verbs + their help) inside export_serial. Default ON. When OFF the prod image keeps only
 * the cmd + stream + OTA-receive transport; the dev UX moves to the dev controller. */
#define CFG_HAS_DEVUX      @CFG_HAS_DEVUX@

#define CFG_FUSED_LOG_HZ   @CFG_FUSED_LOG_HZ@

/* trk_json.c's jsmn scratch-token cap (Plan 7 Task 1 DRAM reclaim): the only JSON venue parsed on
 * a firmware build is gps_sim's 330-byte capture venue (~48 tokens); uploads of large venues are
 * a host-tool path (trk_json.c falls back to 512 when this header is absent). */
#define CFG_TRK_JSON_TOKS  @CFG_TRK_JSON_TOKS@

#endif /* BUILD_CONFIG_H */
