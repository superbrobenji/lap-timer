CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Keep the UART RX ISR in IRAM (T-C): during `ota recv` each 4 KB chunk drives esp_ota_write(),
# a ~10-40 ms flash program with the cache disabled on both cores. With the ISR in IRAM it keeps
# draining the 128 B HW FIFO into the console's 256 B RX ring throughout that cache-off window;
# without it the FIFO overflows in ~11 ms and image bytes are dropped. The 256 B ring itself is
# fixed by IDF's REPL (no Kconfig) -- see the RX-ring note in export_serial.c ota_recv_stream().
CONFIG_UART_ISR_IN_IRAM=y
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
# --- Bluetooth: OFF (ruling R33, docs/superpowers/specs/2026-10-13-audit-fix-wave-design.md) ---
# No BLE code is compiled on main: components/drivers/conn_ble does not exist here, CONN=ble
# appends no driver directory, and the NimBLE host is parked on branch s5.2-conn-ble. With
# CONFIG_BT_ENABLED=y the linker still reserves the BT controller's DRAM -- dram0_0_seg starts at
# 0x3ffbdb5c with length 0x1e6a4 (124,580 B) instead of 0x3ffb0000 / 0x2c200 (180,736 B), i.e.
# ~56 KB of static DRAM held for a stack that is not linked. CFG_HAS_BLE (build_config.h) and the
# hwid string are unchanged, so OTA compatibility (§19.7) is unaffected.
#
# SUB-PROJECT C / branch s5.2-conn-ble MUST restore the block below when it activates BLE, and
# re-measure: the DRAM headroom this reservation was consuming is now available to other uses and may be spent there.
CONFIG_BT_ENABLED=n
#CONFIG_BT_NIMBLE_ENABLED=y
#CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
#CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
#CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
#CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
#CONFIG_BT_NIMBLE_PINNED_TO_CORE_0=y
#CONFIG_BTDM_CTRL_PINNED_TO_CORE_0=y
CONFIG_ESP_WIFI_ENABLED=n          # overridden in *_wifi envs
CONFIG_LITTLEFS_MAX_PARTITIONS=1
# LittleFS geometry per spec §13.1 (block_size 4096 is fixed by the component for the ESP32).
CONFIG_LITTLEFS_READ_SIZE=128
CONFIG_LITTLEFS_WRITE_SIZE=128
CONFIG_LITTLEFS_CACHE_SIZE=512
CONFIG_LITTLEFS_LOOKAHEAD_SIZE=128
CONFIG_LITTLEFS_BLOCK_CYCLES=512
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# §19.2 signed OTA images (ECDSA Secure Boot V1 scheme, NO secure boot; secure boot is sub-project C).
# BUILD_SIGNED_BINARIES=n: images are signed manually via tools/sign_release.sh (CI has no private key),
# and VERIFICATION_KEY only applies when BUILD_SIGNED_BINARIES is off. Rollback is already enabled above.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_ECDSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=n
CONFIG_SECURE_BOOT_VERIFICATION_KEY="keys/laptimer_pub.pem"
